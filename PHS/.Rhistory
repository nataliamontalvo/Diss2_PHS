geom_col() +
scale_fill_discrete_phs(palette = "main") +
scale_y_continuous(labels = scales::comma) +
labs(title = "Attendances by Sex", x = "Sex", y = "Total Attendances") +
theme_phs()
sex_plt
ggsave("figures/m_demo/attendances_by_sex.pdf", plot = sex_plt, width = 6, height = 5)
