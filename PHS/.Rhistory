summarise_columns(month_activity_data)
month_activity_data <- read.csv("datasets/monthly_ae_activity_202605.csv")
summarise_columns(month_activity_data)
head(month_activity_data)
tail(month_activity_data)
head(month_activity_data)
head(referrals_data)
head(month_demo_data)
referral_monthly <- referrals_data %>%
mutate(Referral = case_when(
is.na(Referral) | trimws(Referral) %in% c("", ":") ~ "Not Known",
TRUE ~ Referral
)) %>%
group_by(Month, HBT, TreatmentLocation, Referral) %>%
summarise(referral_total = sum(NumberOfAttendances, na.rm = TRUE), .groups = "drop") %>%
group_by(Month, HBT, TreatmentLocation) %>%
mutate(referral_pct = referral_total / sum(referral_total) * 100) %>%
ungroup()
# Pivot wide so each referral type is its own column - easier to use as model predictors
referral_monthly_wide <- referral_monthly %>%
select(Month, HBT, TreatmentLocation, Referral, referral_pct) %>%
pivot_wider(names_from = Referral, values_from = referral_pct, values_fill = 0,
names_prefix = "pct_")
activity_monthly <- month_activity_data %>%
filter(AttendanceCategory == "All") %>%
mutate(across(c(NumberOfAttendancesAll, NumberWithin4HoursAll, PercentageWithin4HoursAll,
PercentageOver8HoursEpisode, PercentageOver12HoursEpisode),
~ ifelse(. == "z", NA, .))) %>%   # catch suppressed values, if any leak through as text
select(Month, HBT, TreatmentLocation, DepartmentType,
NumberOfAttendancesAll, PercentageWithin4HoursAll,
PercentageOver8HoursEpisode, PercentageOver12HoursEpisode)
combined_monthly <- activity_monthly %>%
left_join(referral_monthly_wide, by = c("Month", "HBT", "TreatmentLocation"))
# Sanity check: how many rows failed to find a referral match (expected for pre-2018 months)
combined_monthly %>%
filter(is.na(pct_Self_Referral)) %>%   # adjust column name to match actual pivot output
count(Month < 201801)
ggplot(combined_monthly %>% filter(!is.na(`pct_Self Referral`)),
aes(x = `pct_Self Referral`, y = PercentageWithin4HoursAll)) +
geom_point(colour = phs_colours("phs-blue"), alpha = 0.4) +
geom_smooth(method = "lm", colour = phs_colours("phs-rust")) +
facet_wrap(~ DepartmentType) +   # now you can split Type 1 vs Type 3!
labs(x = "Self-Referral Share (%)", y = "% Seen Within 4 Hours",
title = "Self-Referral Rate vs. 4-Hour Performance, by Department Type") +
theme_phs()
