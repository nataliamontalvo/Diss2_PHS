# Any codes in week_activity_data with no match in trt_loc?
week_activity_data %>%
filter(is.na(TreatmentLocationName)) %>%
distinct(TreatmentLocation)
# Reverse check: which of your 32 codes matched, and to what?
week_activity_data %>%
distinct(TreatmentLocation, TreatmentLocationName, HB, CurrentDepartmentType, Status)
week_activity_data %>%
filter(HBT != HB) %>%
nrow()  # should be 0 if consistent
